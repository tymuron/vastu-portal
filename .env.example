# Server-side only (used by server.js for the lava.top webhook).
# Never expose these in the frontend / Vite env vars.
SUPABASE_URL=https://jjztzunutlcnfnzaclun.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-dashboard
LAVA_WEBHOOK_API_KEY=replace-with-the-api-key-you-paste-into-lava-top-integration-tab
# Optional: where to redirect users after they set their password (defaults to APP origin).
APP_URL=https://your-deployed-app.example.com

# Purchase fulfilment (fulfilment.js)
LAVA_API_KEY=replace-with-lava-top-api-key
RESEND_API_KEY=replace-with-resend-key
# From header; its domain must be verified in Resend (annaromeo.design expired 2026-09).
RESEND_FROM=Anna Romeo <hello@annaromeovastu.com>
CRON_SECRET=long-random-string-for-/grant-and-cron-endpoints
# Who hears about a paid buyer that didn't get access or the email.
ALERT_EMAIL=you@example.com
# Signs the /access links in welcome emails (falls back to one derived from CRON_SECRET).
ACCESS_LINK_SECRET=another-long-random-string
# lava.top sales poll: sales created at/after this moment are fulfilled. Unset = poll off.
RECONCILE_SINCE=2026-10-23T00:00:00Z
RECONCILE_INTERVAL_MIN=3

# New-lesson notifications (lessonNotify.js). off (default) | dry-run (logs who
# would get what, sends nothing) | live.
LESSON_NOTIFY=off
# Required for live: lessons that opened before this moment are never announced.
LESSON_NOTIFY_SINCE=2026-11-11T00:00:00Z
# Optional (defaults): LESSON_NOTIFY_COURSES=vastu-design-2026,vastu-design-2026-pro
# LESSON_NOTIFY_SETTLE_MIN=30  LESSON_NOTIFY_HOURS=9-21  LESSON_NOTIFY_TZ=Europe/Moscow
# Telegram: a bot that is an admin of the course channel, and the channel's id
# per course slug (find it with GET /api/admin/lesson-notify/telegram-chats).
TELEGRAM_BOT_TOKEN=
LESSON_NOTIFY_TELEGRAM=vastu-design-2026=-1001234567890
